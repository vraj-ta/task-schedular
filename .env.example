# =============================================================================
# Task Scheduler — docker-compose env file.
# Copy to .env and replace ALL placeholder values. The api service refuses to
# boot if any of the required values are missing or fail validation.
#
#   cp .env.example .env
#   # then fill in the secrets (see commands below)
#
# Generate strong secrets:
#   openssl rand -hex 32
# =============================================================================

# ---- Postgres -------------------------------------------------------------
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=scheduler
POSTGRES_DB=task_scheduler
# Host port mapped to the container's 5432. Default 5433 to avoid colliding
# with a local Postgres install.
POSTGRES_PORT=5433

# ---- Required secrets (REPLACE these) -------------------------------------
# AES-256-GCM key for encrypting PlatformConnection.jwtSecret. 32 bytes hex.
SCHEDULER_SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32

# Static bearer for service/CLI access to /api/admin/* (separate from UI login).
# Minimum 32 chars.
SCHEDULER_ADMIN_API_KEY=REPLACE_WITH_openssl_rand_hex_32

# HMAC signing key for operator-UI access-token JWTs.
ADMIN_JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32

# HMAC signing key for artifact download URLs.
ARTIFACT_SIGNING_KEY=REPLACE_WITH_openssl_rand_hex_32

# ---- Optional tuning ------------------------------------------------------
SCHEDULER_PORT=4100
WEB_PORT=5173

LOG_LEVEL=info

ADMIN_ACCESS_TOKEN_TTL_MIN=15
ADMIN_REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=10
ARTIFACT_URL_TTL_SECONDS=600

WORKER_LOCK_TTL_MS=300000
REAPER_INTERVAL_MS=30000
SCHEDULER_TICK_INTERVAL_MS=15000
LONG_POLL_TIMEOUT_MS=30000

IN_PROCESS_WORKER_ENABLED=true
IN_PROCESS_WORKER_CONCURRENCY=2
IN_PROCESS_WORKER_IDLE_MS=1000

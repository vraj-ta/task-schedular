# Control-plane database (own Postgres — see docs/architecture.md decision #2)
SCHEDULER_DATABASE_URL=postgresql://scheduler:scheduler@localhost:5432/task_scheduler

# HTTP
SCHEDULER_PORT=4100

# Crypto — 32-byte hex key for AES-256-GCM encryption of PlatformConnection secrets
SCHEDULER_SECRET_KEY=

# HMAC secret used to mint worker bearer tokens at registration
SCHEDULER_WORKER_HMAC_SECRET=

# Artifact storage (Phase 1: local FS only)
ARTIFACT_STORAGE=local
ARTIFACT_LOCAL_PATH=/var/scheduler/artifacts

# Node
NODE_ENV=development

# Local-dev env (used by `npm run dev --workspace=@task-scheduler/api`).
# For Docker, use the repo-root .env.example (it drives docker-compose).
#
# Generate strong secrets:
#   openssl rand -hex 32

# Control-plane database
SCHEDULER_DATABASE_URL=postgresql://scheduler:scheduler@localhost:5433/task_scheduler

# HTTP
SCHEDULER_PORT=4100

# Required secrets (replace placeholders)
SCHEDULER_SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
SCHEDULER_ADMIN_API_KEY=REPLACE_WITH_openssl_rand_hex_32
ADMIN_JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
ARTIFACT_SIGNING_KEY=REPLACE_WITH_openssl_rand_hex_32

# Artifact storage (Phase 1: local FS only)
ARTIFACT_STORAGE=local
ARTIFACT_LOCAL_PATH=./.artifacts

# Optional tuning — defaults shown
NODE_ENV=development
LOG_LEVEL=info
ADMIN_ACCESS_TOKEN_TTL_MIN=15
ADMIN_REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=10
ARTIFACT_URL_TTL_SECONDS=600

WORKER_LOCK_TTL_MS=300000
REAPER_INTERVAL_MS=30000
SCHEDULER_TICK_INTERVAL_MS=15000
LONG_POLL_TIMEOUT_MS=30000

IN_PROCESS_WORKER_ENABLED=true
IN_PROCESS_WORKER_CONCURRENCY=2
IN_PROCESS_WORKER_IDLE_MS=1000
